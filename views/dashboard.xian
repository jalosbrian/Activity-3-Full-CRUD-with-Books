{{> head}}
<body class="bg-gray-100">

{{> header}}

<div class="flex">
  {{> sidebar}}

  <main class="flex-1">
    {{> breadcrumbs}}

    <div class="p-6">
      <h2 class="text-2xl font-bold mb-6 text-gray-800">Welcome, Admin</h2>

      {{#databaseError}}
      <div class="mb-6 rounded-lg border border-yellow-200 bg-yellow-50 px-4 py-3 text-sm text-yellow-800">
        {{ message }}
      </div>
      {{/databaseError}}

      {{> metrics}}
      {{> table}}
    </div>
  </main>
</div>

{{> footer}}