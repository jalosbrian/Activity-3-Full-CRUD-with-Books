<!DOCTYPE html>
<html lang="en">
<head>
	<meta charset="UTF-8">
	<meta name="viewport" content="width=device-width, initial-scale=1.0">
	<title>Page One</title>
	<script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8">
	<main class="mx-auto max-w-4xl rounded-lg bg-white p-6 shadow">
		<h1 class="mb-2 text-2xl font-bold text-gray-800">Page One</h1>
		<p class="mb-6 text-gray-600">{{ name }} - {{ content }}</p>

		<div class="overflow-x-auto">
			<table class="w-full text-left text-sm">
				<thead class="bg-gray-100 text-xs uppercase text-gray-600">
					<tr>
						<th class="px-4 py-3">Name</th>
						<th class="px-4 py-3">Age</th>
						<th class="px-4 py-3">Address</th>
					</tr>
				</thead>
				<tbody class="divide-y">
					{{#data}}
					<tr>
						<td class="px-4 py-3">{{ name }}</td>
						<td class="px-4 py-3">{{ age }}</td>
						<td class="px-4 py-3">{{ address }}</td>
					</tr>
					{{/data}}
				</tbody>
			</table>
		</div>
	</main>
</body>
</html>