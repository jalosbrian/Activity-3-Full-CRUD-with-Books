<div class="bg-white rounded-lg shadow">
  <div class="px-5 py-4 border-b flex justify-between items-center">
    <h3 class="font-semibold text-gray-800">Recent Orders</h3>
    <a href="#" class="text-sm text-blue-600 hover:underline">View all</a>
  </div>
  <table class="w-full text-sm text-left">
    <thead class="bg-gray-50 text-gray-500 uppercase text-xs">
      <tr>
        <th class="px-5 py-3">Order ID</th>
        <th class="px-5 py-3">Customer</th>
        <th class="px-5 py-3">Date</th>
        <th class="px-5 py-3">Amount</th>
        <th class="px-5 py-3">Status</th>
      </tr>
    </thead>
    <tbody class="divide-y">
      {{#orders}}
      <tr>
        <td class="px-5 py-3">{{ orderId }}</td>
        <td class="px-5 py-3">{{ customer }}</td>
        <td class="px-5 py-3">{{ date }}</td>
        <td class="px-5 py-3">{{ amount }}</td>
        <td class="px-5 py-3">{{ status }}</td>
      </tr>
      {{/orders}}
      {{^orders}}
      <tr>
        <td class="px-5 py-3 text-gray-500" colspan="5">No orders found.</td>
      </tr>
      {{/orders}}
    </tbody>
  </table>
</div>